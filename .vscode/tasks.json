{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "First-Agent: host bootstrap",
      "type": "process",
      "command": "uvx",
      "args": [
        "--from",
        "rust-just==1.57.0",
        "just",
        "agent-bootstrap"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "API key probe: проверка ключа (--check)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "${workspaceFolder}/scripts/api_key_probe.py",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "API key probe: модели (--models)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "${workspaceFolder}/scripts/api_key_probe.py",
        "--models"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "API key probe: чат (Coarena, --save)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "${workspaceFolder}/scripts/api_key_probe.py",
        "--save",
        "${workspaceFolder}/probe-chat.md"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
