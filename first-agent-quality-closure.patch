+# Frozen dependency allowlist for the First-Agent runtime and development gates.
+# This file is tracked despite the rest of .fa/ being runtime state.
+# Changes require explicit dependency/TCB review (ADR-11-I7 / S15).
+
+[kernel]
+format = "1"
+policy = "package names are allowlisted; versions remain governed by pyproject.toml and uv.lock"
+
+[packages.core]
+markdown-it-py = ">=3.0"
+fastjsonschema = ">=2.21"
+pyyaml = ">=6.0"
+bashlex = ">=0.18"
+libtmux = ">=0.40"
+pexpect = ">=4.9"
+
+[packages.security_critical]
+fastjsonschema = "tool-argument and envelope schema validation"
+bashlex = "bash intent AST analysis"
+
+[packages.optional.runtime]
+# Deferred integrations; not installed by default.
+pymupdf = ">=1.24"       # import name: fitz
+pdfminer-six = ">=20231228" # import name: pdfminer
+pypdf = ">=4.0"
+fastapi = ">=0.115"
+pydantic = ">=2.0"
+requests = ">=2.32"
+
+[packages.dev]
+mypy = ">=1.10"
+pre-commit = ">=3.7"
+pytest = ">=8.2"
+pytest-asyncio = ">=0.23"
+pytest-cov = ">=5.0"
+mutmut = ">=3.0"
+ruff = ">=0.5"
+types-PyYAML = ">=6.0"
+pytest-gremlins = ">=0.2"
+pip-audit = ">=2.7"
+deptry = ">=0.21"
+pyrefly = ">=1.1.1"
+pylint = ">=3.2"
+vulture = ">=2.11"
+
+[registries]
+python = "https://pypi.org/simple"
