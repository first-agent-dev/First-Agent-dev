#!/usr/bin/env bash
# scripts/fa — unified FA operator interface (host-side).
#
# Two layers behind one command:
#   1. Infrastructure verbs (logs, restart, up, down, rebuild, status, shell)
#      run on the HOST via docker compose — closed set, docker compose API.
#   2. Everything else delegates to `fa` CLI INSIDE the agent container
#      (selfcheck, probe, run, chunk, authoring-check, --version, …).
#      New Python subcommands work automatically — no wrapper change needed.
#
# Install:  sudo ln -sf /srv/first-agent/repo/First-Agent-dev/scripts/fa /usr/local/bin/fa
# Override: FA_COMPOSE_FILE=docker-compose.custom.yml fa status

set -euo pipefail

# Resolve symlink: when installed as /usr/local/bin/fa → scripts/fa,
# $0 is the symlink path, not the target. readlink -f follows the chain.
_SELF="$(readlink -f "$0")"
REPO_DIR="$(cd "$(dirname "$_SELF")/.." && pwd)"
COMPOSE_FILE="${FA_COMPOSE_FILE:-docker-compose.fa.yml}"
# Use a BASH ARRAY (not a string) for COMPOSE so expansion doesn't word-split
# paths with spaces and so flags compose correctly ("${COMPOSE[@]}" always
# expands to exactly the argv words we put in). Senior bash pattern — the
# bare-string `COMPOSE="docker compose -f $VAR"` is a classic footgun.
COMPOSE=(docker compose -f "${REPO_DIR}/${COMPOSE_FILE}")

# TTY detection: pass -T (disable TTY) when stdin is not a terminal
# (pipes, scripts, cron). Keep TTY for interactive use (fa shell).
# Arrays let "no flag" contribute ZERO words (instead of an empty string
# that docker compose would treat as an argument).
TTY_FLAG=(-T)
if [ -t 0 ] && [ -t 1 ]; then
    TTY_FLAG=()
fi

# Resolve active session workspace for docker exec commands
_SESSION_WORKSPACE=""
_FA_ROOT="$(dirname "$(dirname "$REPO_DIR")")"
if [[ -f "$_FA_ROOT/sessions/.active" ]]; then
    _SESSION_WORKSPACE="$(cat "$_FA_ROOT/sessions/.active")"
fi

_W_FLAG=()
if [[ -n "$_SESSION_WORKSPACE" ]]; then
    _W_FLAG=(-w "$_SESSION_WORKSPACE")
fi

# Return truthy when an active session workspace is set (used by case branches).
_have_workspace() { [[ -n "$_SESSION_WORKSPACE" ]]; }

_is_help_arg() {
    case "${1:-}" in
        -h|--help|-help|help) return 0 ;;
        *) return 1 ;;
    esac
}

_help_unavailable() {
    printf '%s\n' "fa: wrapper help is disabled until the isolated installed-controller help seam is available" >&2
    exit 2
}

_print_usage() {
    _help_unavailable
}

_has_help_option() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            -h|--help|-help) return 0 ;;
        esac
    done
    return 1
}

_host_has_help() {
    _is_help_arg "${1:-}" || _has_help_option "$@"
}

_delegate_to_agent() {
    if _have_workspace; then
        exec "${COMPOSE[@]}" exec "${TTY_FLAG[@]}" "${_W_FLAG[@]}" first-agent fa "$@"
    else
        exec "${COMPOSE[@]}" exec "${TTY_FLAG[@]}" first-agent fa "$@"
    fi
}

case "${1:-}" in
    # ── Infrastructure verbs (host-side, docker compose level) ──────────
    logs)
        shift
        if _host_has_help "$@"; then _help_unavailable; fi
        exec "${COMPOSE[@]}" logs "$@" first-agent
        ;;
    proxy-logs)
        shift
        if _host_has_help "$@"; then _help_unavailable; fi
        exec "${COMPOSE[@]}" logs "$@" fa-egress-proxy
        ;;
    egress-proxy)
        shift
        if _host_has_help "$@"; then _help_unavailable; fi
        printf '%s\n' "fa: egress-proxy is managed by the fa-egress-proxy Compose service; use 'fa up' to start it" >&2
        exit 2
        ;;
    status)
        shift
        if _host_has_help "$@"; then _help_unavailable; fi
        exec "${COMPOSE[@]}" ps
        ;;
    up)
        shift
        if _host_has_help "$@"; then _help_unavailable; fi
        exec "${COMPOSE[@]}" up -d
        ;;
    down)
        shift
        if _host_has_help "$@"; then _help_unavailable; fi
        exec "${COMPOSE[@]}" down
        ;;
    restart)
        shift
        if _host_has_help "$@"; then _help_unavailable; fi
        exec "${COMPOSE[@]}" restart first-agent fa-egress-proxy
        ;;
    rebuild)
        shift
        if _host_has_help "$@"; then _help_unavailable; fi
        exec "${COMPOSE[@]}" up -d --build
        ;;
    shell)
        shift
        if _host_has_help "$@"; then _help_unavailable; fi
        # shell uses TTY (interactive) — docker picks up the terminal from
        # stdin/stdout; ${TTY_FLAG[@]} is empty for interactive, -T for non-tty.
        # Arrays-as-flags: use _have_workspace helper to avoid testing an
        # empty-array expansion with -n (which is always false).
        if _have_workspace; then
            exec "${COMPOSE[@]}" exec "${TTY_FLAG[@]}" "${_W_FLAG[@]}" first-agent bash "$@"
        else
            exec "${COMPOSE[@]}" exec "${TTY_FLAG[@]}" first-agent bash "$@"
        fi
        ;;
    update)
        shift
        if _host_has_help "$@"; then _help_unavailable; fi
        exec "$REPO_DIR/scripts/fa-update.sh" "$@"
        ;;
    clean-rebuild)
        shift
        if _host_has_help "$@"; then _help_unavailable; fi
        exec "$REPO_DIR/scripts/fa-clean-rebuild.sh" "$@"
        ;;
    clean)
        if _host_has_help "${@:2}"; then _help_unavailable; fi
        if [[ "${2:-}" == "rebuild" || "${2:-}" == "clean-rebuild" ]]; then
            echo "fa: use 'fa clean-rebuild' (hyphen), not 'fa clean rebuild'" >&2
            exit 2
        fi
        _delegate_to_agent "$@"
        ;;
    commit-traces)
        shift
        if _host_has_help "$@"; then _help_unavailable; fi
        cd "$REPO_DIR"
        # -f: force-add gitignored trace files (they're ignored by default
        # so fa-update.sh stays clean; commit-traces is the deliberate path).
        git add -f knowledge/trace/codebase_map.json knowledge/trace/gotchas.md 2>/dev/null
        git diff --cached --quiet && { echo "fa: no trace changes to commit"; exit 0; }
        git commit -m "chore: update session trace artifacts"
        echo "fa: trace artifacts committed"
        exit 0
        ;;
    sessions)
        shift
        if _host_has_help "$@"; then _help_unavailable; fi
        # shellcheck disable=SC2010
        ls -lt "$_FA_ROOT/sessions/" | grep -v "^total\\|\.active"
        ;;

    # ── Help ────────────────────────────────────────────────────────────
    ""|--help|-h|-help)
        _print_usage
        ;;
    help)
        _help_unavailable
        ;;

    # ── Default: delegate product commands to the agent container ───────
    *)
        if _has_help_option "$@"; then _help_unavailable; fi
        _delegate_to_agent "$@"
        ;;
esac
