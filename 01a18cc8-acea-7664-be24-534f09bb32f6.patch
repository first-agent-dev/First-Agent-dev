+def build_managed_subagent_tool(  # noqa: C901
+    *,
+    workspace_root: Path,
+    run_log_dir: Path,
+    managed: ManagedExecution,
+    parent_state: SessionState,
+    parent_role: str,
+    chat_chain: ProviderChain | None,
