+class _RecordingHandoffClient:
+    """Keep HANDOFF calls observable while ManagedExecution owns their semantics."""
+
+    def __init__(self, events: list[str], *, failure: tuple[int, BaseException] | None = None) -> None:
+        self.events = events
+        self.failure = failure
+        self.calls: list[tuple[NamespaceRef, NamespaceRef, str, float | None]] = []
+
+    def handoff(
+        self,
+        binding: ExecutionBinding,
+        target: NamespaceRef,
+        *,
+        grant: GrantReply,
+        expected_revision_id: str,
+        request_id: str,
+        deadline: float | None = None,
+    ) -> GrantReply:
+        source = binding.namespace
+        self.events.append("handoff")
+        self.calls.append((source, target, request_id, deadline))
+        if self.failure is not None and len(self.calls) == self.failure[0]:
+            raise self.failure[1]
+        return GrantReply(
+            Operation.HANDOFF,
+            "c" * 64,
+            None,
+            grant.generation,
+            expected_revision_id,
+        )
+
+
+class _RecordingParentLease:
+    is_handoff_enabled = True
+
+    def __init__(self, events: list[str], *, fail_resume: bool = False) -> None:
+        self.events = events
+        self.state = "active"
+        self.deadlines: list[float | None] = []
+        self.fail_resume = fail_resume
+
+    def suspend(self, *, deadline: float | None = None) -> str:
+        assert self.state == "active"
+        self.state = "suspended"
+        self.deadlines.append(deadline)
+        self.events.append("suspend")
+        return "rev-" + "a" * 32
+
+    def resume(self, *, deadline: float | None = None) -> None:
+        assert self.state == "suspended"
+        self.deadlines.append(deadline)
+        self.events.append("resume")
+        if self.fail_resume:
+            self.state = "broken"
+            raise RuntimeError("resume was not proved")
+        self.state = "active"
+
+
+def _workflow_session_manager(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> tuple[Any, Path]:
+    """Provide the typed managed lifecycle seam used by handoff unit tests."""
+    from fa.session.manager import SessionManager
+    from fa.session.provisioning import ProvisionedWorkspace, ProvisionMode
+    from fa.workspace_bootstrap import ReadyState, ReadyStatus
+
+    def provision(request: Any) -> ProvisionedWorkspace:
+        assert request.mode is ProvisionMode.PROVISION
+        request.workspace_path.mkdir(parents=True, exist_ok=False)
+        return ProvisionedWorkspace(
+            registered=True,
+            workspace_id="ws-workflow-test",
+            revision_id="rev-workflow-test",
+            tree_sha256="a" * 64,
+        )
+
+    def prepare(workspace: Path, _run_context: Any) -> ReadyState:
+        return ReadyState(
+            status=ReadyStatus.READY,
+            fingerprint="sha256:workflow-test",
+            reason_code="ready_managed_artifact",
+            log_path=workspace / ".fa" / "managed-readiness.log",
+            repaired=False,
+            elapsed_ms=1,
+        )
+
+    state_root = tmp_path / "state"
+    monkeypatch.setenv("FA_STATE_ROOT", str(state_root))
+    manager = SessionManager(
+        state_root=state_root,
+        workspace_root=tmp_path / "workspaces",
+        workspace_preparer=prepare,
+        workspace_provisioner=provision,
+    )
