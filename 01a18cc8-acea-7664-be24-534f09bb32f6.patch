+            try:
+                view_settled = managed.stop_view(view_grant)
+            except Exception as error:  # noqa: BLE001 - preserve the stage's original failure
+                view_settled = False
+                logger.warning("managed stage view cleanup failed (run=%s): %s", run_id, error)
+        raise
