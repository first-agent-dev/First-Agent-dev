+                provider_chain=chat_chain,
+                compactor_chain=chat_compactor,
+                registry=child_registry,
+                hooks=child_hooks,
+                state=child_state,
+                role="subagent",
+                acting_family=chat_chain.config.family,
+                limits=limits,
+                max_turns=_MAX_CHILD_TURNS,
+                system_prompt_extra="",
+                initial_memory_summary="",
