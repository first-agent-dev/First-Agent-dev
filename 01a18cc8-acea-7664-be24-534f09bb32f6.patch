+            PlanRef(source.ref.workspace_relative_path, source.ref.source_kind, candidate.ref.sha256),
+            "rev-" + "7" * 32,
+            False,
+        )
+
+    monkeypatch.setattr(ManagedExecution, "publish_plan", fake_publish)
+    seen: dict[str, Any] = {}
