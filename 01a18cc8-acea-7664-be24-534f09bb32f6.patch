+def _run_cli_stage(
+    *,
+    args: argparse.Namespace,
+    run_context: RunContext | None,
+    run_id: str,
+    run_log_dir: Path,
+    session_db: SessionDatabase | None,
+    log: EventLog,
+    workspace: Path,
+    role: str,
