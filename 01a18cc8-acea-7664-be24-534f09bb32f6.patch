+@pytest.mark.parametrize(
+    ("tool", "params", "expected_tool_result"),
+    [
+        (
+            "fs_search",
+            {"output_mode": "files"},
+            "ERROR[search_failed]: managed search refused (candidate_budget)",
+        ),
+        (
+            "fs_reach",
+            {"symbol": "Site", "direction": "down"},
+            "ERROR[reach_failed]: managed reach refused (candidate_budget)",
+        ),
