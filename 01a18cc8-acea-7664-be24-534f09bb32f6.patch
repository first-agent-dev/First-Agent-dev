+                outcome,
+                child_run_id=child_run_id,
+                parent_run_id=parent_run_id,
+                parent_role=parent_role,
+                duration_ms=int((time.monotonic() - started) * 1000),
+                redactor=redactor,
+            )
+            report_json = report.to_json()
