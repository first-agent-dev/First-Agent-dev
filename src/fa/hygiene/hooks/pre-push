#!/usr/bin/env bash
# pre-push — run the repo-native CI gate before an agent pushes a branch.
#
# The pre-commit hook runs ~90% of checks (ruff, format, deptry, pylint-gap,
# mypy strict, pyrefly, shell-syntax, gitleaks, markdownlint, doc-links,
# whitespace, uv-lock) in under a minute. This pre-push hook is the final
# blocking layer: it runs `uv run --no-sync just check-deep`, which includes the full
# non-mutational `just check` chain PLUS targeted-mutmut and targeted-semgrep
# on files changed vs merge-base. GitHub CI remains the final authority;
# this hook is a convenience net for honest mistakes.
#
# Targeted gates (not full-repo): mutmut and semgrep run against changed
# Python files only. Full-repo mutmut and full-repo semgrep remain on
# weekly scheduled CI, not on the push critical path.
#
# Escape hatch for exceptional operator cases:
#   FA_HOOK_SKIP_FULL_CHECK=1 git push
#
# Narrower escape hatches (skip only the heavy targeted gates but still
# run the rest of `just check`):
#   FA_SKIP_TARGETED_MUTATION=1 git push
#   FA_SKIP_TARGETED_SEMGREP=1 git push
#
# Do not use escape hatches in normal agent runs. If this hook fails, fix
# the code or push only when you intentionally want CI/review to surface
# the failure.

set -euo pipefail

# BEGIN FA WORKSPACE READINESS
_fa_bootstrap_rc=0
_fa_bootstrap_json=""
_fa_repo_root=""
if _fa_repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    if [[ -n "$_fa_repo_root" ]]; then
        if _fa_bootstrap_json="$(
            python3 "$_fa_repo_root/scripts/bootstrap/workspace.py" ensure --workspace "$_fa_repo_root"
        )"; then
            :
        else
            _fa_bootstrap_rc=$?
        fi
    else
        _fa_bootstrap_rc=70
    fi
else
    _fa_bootstrap_rc=$?
fi

if [[ "$_fa_bootstrap_rc" -ne 0 ]]; then
    if [[ -n "$_fa_repo_root" ]]; then
        printf '[WORKSPACE_BOOTSTRAP] hook readiness unavailable (rc=%s); continuing without local gate; log=%s/.fa/bootstrap.log\n' \
            "$_fa_bootstrap_rc" "$_fa_repo_root" >&2
    else
        printf '[WORKSPACE_BOOTSTRAP] hook readiness unavailable (rc=%s); continuing without local gate\n' \
            "$_fa_bootstrap_rc" >&2
    fi
    exit 0
fi
unset _fa_bootstrap_json _fa_bootstrap_rc _fa_repo_root
# END FA WORKSPACE READINESS

if [[ "${FA_HOOK_SKIP_FULL_CHECK:-0}" == "1" ]]; then
    echo "pre-push: skipping uv run --no-sync just check-deep (FA_HOOK_SKIP_FULL_CHECK=1)" >&2
    exit 0
fi

if ! command -v uv >/dev/null 2>&1; then
    echo "pre-push: uv not found on PATH; install uv or set FA_HOOK_SKIP_FULL_CHECK=1" >&2
    exit 127
fi

if ! command -v just >/dev/null 2>&1; then
    echo "pre-push: just not found on PATH; install just or set FA_HOOK_SKIP_FULL_CHECK=1" >&2
    exit 127
fi

echo "pre-push: running uv run --no-sync just check-deep" >&2
# Redirect stdout to stderr (1>&2) so that Git GUI clients (like VS Code)
# reliably display the full lint/test output in their error dialogs,
# rather than swallowing the stdout and only showing the justfile exit code.
uv run --no-sync just check-deep 1>&2
