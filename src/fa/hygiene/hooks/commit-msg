#!/usr/bin/env bash
# commit-msg — validate the composed commit-message body against
# knowledge/skills/pr-creation/SKILL.md §What the hook validates.
#
# Returns all violations in one pass (no short-circuit). A non-zero
# exit blocks the commit; the agent / contributor fixes every
# reported violation and retries.
#
# Git-generated messages (merge, cherry-pick, revert, amend) are
# skipped so that standard git operations are never blocked by the
# validator. The prepare-commit-msg hook already skips injection for
# these sources; this hook must match that logic.
#
# Message-source commits (git commit -m "...", VS Code Git extension)
# are also handled: when the message contains no PR-intent metadata
# headers at all, the Python validator treats it as an ordinary manual
# commit and does not require the rich PR-intent format. Explicit
# metadata blocks remain strictly validated.
#
# Uses ``uv run`` to ensure the project environment (with the latest
# source) is used, avoiding stale bytecode or PATH issues on Windows.

set -euo pipefail

# BEGIN FA WORKSPACE READINESS
_fa_bootstrap_rc=0
_fa_bootstrap_json=""
_fa_repo_root=""
if _fa_repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    if [[ -n "$_fa_repo_root" ]]; then
        if _fa_bootstrap_json="$(
            python3 "$_fa_repo_root/scripts/bootstrap/workspace.py" ensure --workspace "$_fa_repo_root"
        )"; then
            :
        else
            _fa_bootstrap_rc=$?
        fi
    else
        _fa_bootstrap_rc=70
    fi
else
    _fa_bootstrap_rc=$?
fi

if [[ "$_fa_bootstrap_rc" -ne 0 ]]; then
    if [[ -n "$_fa_repo_root" ]]; then
        printf '[WORKSPACE_BOOTSTRAP] hook readiness unavailable (rc=%s); continuing without local gate; log=%s/.fa/bootstrap.log\n' \
            "$_fa_bootstrap_rc" "$_fa_repo_root" >&2
    else
        printf '[WORKSPACE_BOOTSTRAP] hook readiness unavailable (rc=%s); continuing without local gate\n' \
            "$_fa_bootstrap_rc" >&2
    fi
    exit 0
fi
unset _fa_bootstrap_json _fa_bootstrap_rc _fa_repo_root
# END FA WORKSPACE READINESS

COMMIT_MSG_FILE="${1:-}"
if [[ -z "${COMMIT_MSG_FILE}" ]]; then
  echo "commit-msg: missing commit-msg file argument" >&2
  exit 1
fi

# Locate .git directory (git sets GIT_DIR when running hooks, but
# fall back to the standard location relative to the work tree).
GIT_DIR_PATH="${GIT_DIR:-.git}"

# Skip validation for git-generated commit sources detected via
# state files left by git in .git/.
for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
  if [[ -f "${GIT_DIR_PATH}/${marker}" ]]; then
    exit 0
  fi
done

# Skip for amend / merge detected via GIT_REFLOG_ACTION env var.
reflog_action="${GIT_REFLOG_ACTION:-}"
if [[ "${reflog_action,,}" == *"merge"* || "${reflog_action,,}" == *"amend"* ]]; then
  exit 0
fi

# Delegate to the Python validator, which handles both:
# - explicit PR-intent metadata blocks (strict validation)
# - ordinary manual commits with no PR-intent headers (allowed)
exec uv run --no-sync python -m fa.hygiene validate "${COMMIT_MSG_FILE}"
