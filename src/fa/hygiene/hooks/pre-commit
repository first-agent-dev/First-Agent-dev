#!/usr/bin/env bash
# pre-commit — run the configured pre-commit hooks via the project environment.
#
# This script replaces the standard ``pre-commit install`` hook.  The
# framework's generated hook locates ``pre-commit`` via PATH, which
# fails in uv-managed environments on Windows (where the executable
# lives inside ``.venv/Scripts/`` and is not on the system PATH).
# Invoking through ``uv run`` ensures the project environment is
# always used regardless of the shell's PATH configuration.
#
# ``pre-commit run`` with no arguments automatically checks only
# staged files — the correct behaviour for a pre-commit hook.
#
# Proxy bypass: pre-commit builds isolated Python virtualenvs and
# runs ``pip install`` inside them.  On Windows, pip reads the
# system proxy from the registry (Internet Settings), even when
# no proxy env vars are set.  If the system proxy is SOCKS-based,
# pip fails with "Missing dependencies for SOCKS support" because
# the isolated env doesn't have PySocks.  Setting ``NO_PROXY=*``
# here tells urllib/requests/pip to bypass all proxies, regardless
# of what the registry says.  This only affects the git hook
# execution path — nothing else on the system.
#
# Auto-retry: Ruff fixes/formats the whole tracked Python tree on every commit,
# then this wrapper re-stages and retries once. It includes originally staged
# files and initially clean tracked Python files changed by Ruff, so latent
# full-tree drift cannot survive until pre-push.
#
# Safety boundary: pre-existing unstaged/partially staged edits and untracked
# files are never auto-staged. If whole-tree Ruff changes such a path, the hook
# fails with an explicit path list instead of absorbing unrelated hunks.
#
# Optional local CI parity: set FA_HOOK_FULL_CHECK=1 to run `uv run --no-sync just check`
# after the fast autofix pass. The default full gate lives in pre-push.

set -euo pipefail

# BEGIN FA WORKSPACE READINESS
_fa_bootstrap_rc=0
_fa_bootstrap_json=""
_fa_repo_root=""
if _fa_repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    if [[ -n "$_fa_repo_root" ]]; then
        if _fa_bootstrap_json="$(
            python3 "$_fa_repo_root/scripts/bootstrap/workspace.py" ensure --workspace "$_fa_repo_root"
        )"; then
            :
        else
            _fa_bootstrap_rc=$?
        fi
    else
        _fa_bootstrap_rc=70
    fi
else
    _fa_bootstrap_rc=$?
fi

if [[ "$_fa_bootstrap_rc" -ne 0 ]]; then
    if [[ -n "$_fa_repo_root" ]]; then
        printf '[WORKSPACE_BOOTSTRAP] hook readiness unavailable (rc=%s); continuing without local gate; log=%s/.fa/bootstrap.log\n' \
            "$_fa_bootstrap_rc" "$_fa_repo_root" >&2
    else
        printf '[WORKSPACE_BOOTSTRAP] hook readiness unavailable (rc=%s); continuing without local gate\n' \
            "$_fa_bootstrap_rc" >&2
    fi
    exit 0
fi
unset _fa_bootstrap_json _fa_bootstrap_rc _fa_repo_root
# END FA WORKSPACE READINESS

# Bypass system SOCKS/HTTP proxy for pip inside pre-commit envs.
# Only affects this hook process and its children — does not
# change system or VS Code proxy settings.
export NO_PROXY="*"

mapfile -d '' staged_paths < <(git diff --cached --name-only -z 2>/dev/null || true)

partial_paths=()
partial_diff_hashes=()
preexisting_unstaged_paths=()
preexisting_unstaged_hashes=()
preexisting_untracked_paths=()
preexisting_untracked_hashes=()

_partial_diff_hash() {
    git diff --binary -- "$1" 2>/dev/null | git hash-object --stdin 2>/dev/null || printf '__unknown__'
}

_file_content_hash() {
    if [[ -f "$1" ]]; then
        git hash-object -- "$1" 2>/dev/null || printf '__unknown__'
    else
        printf '__missing__'
    fi
}

_partial_path_index() {
    local needle="$1"
    local index
    for index in "${!partial_paths[@]}"; do
        if [[ "${partial_paths[$index]}" == "$needle" ]]; then
            printf '%s' "$index"
            return 0
        fi
    done
    return 1
}

_preexisting_unstaged_index() {
    local needle="$1"
    local index
    for index in "${!preexisting_unstaged_paths[@]}"; do
        if [[ "${preexisting_unstaged_paths[$index]}" == "$needle" ]]; then
            printf '%s' "$index"
            return 0
        fi
    done
    return 1
}

_is_staged_path() {
    local needle="$1"
    local path
    for path in "${staged_paths[@]}"; do
        if [[ "$path" == "$needle" ]]; then
            return 0
        fi
    done
    return 1
}

uv_lock_dirty_before=0
uv_lock_diff_hash_before=""
if [[ -f uv.lock ]] && ! git diff --quiet -- uv.lock 2>/dev/null; then
    uv_lock_dirty_before=1
    uv_lock_diff_hash_before="$(_partial_diff_hash uv.lock)"
fi

for path in "${staged_paths[@]}"; do
    [[ -n "$path" ]] || continue
    if ! git diff --quiet -- "$path" 2>/dev/null; then
        partial_paths+=("$path")
        partial_diff_hashes+=("$(_partial_diff_hash "$path")")
    fi
done

# Whole-tree Ruff may repair a tracked Python file that was not part of the
# original commit. Snapshot every pre-existing unstaged tracked path so the
# retry can auto-stage only initially clean files and never absorb unrelated
# human/agent edits. Untracked paths are absent from `git diff` by construction.
mapfile -d '' preexisting_unstaged_paths < <(git diff --name-only -z 2>/dev/null || true)
for path in "${preexisting_unstaged_paths[@]}"; do
    [[ -n "$path" ]] || continue
    preexisting_unstaged_hashes+=("$(_partial_diff_hash "$path")")
done
mapfile -d '' preexisting_untracked_paths < <(git ls-files --others --exclude-standard -z 2>/dev/null || true)
for path in "${preexisting_untracked_paths[@]}"; do
    [[ -n "$path" ]] || continue
    preexisting_untracked_hashes+=("$(_file_content_hash "$path")")
done

_run_fast_hooks() {
    uv run --no-sync pre-commit run --hook-stage pre-commit "$@"
}

_run_optional_full_check() {
    if [[ "${FA_HOOK_FULL_CHECK:-0}" == "1" ]]; then
        echo "pre-commit: FA_HOOK_FULL_CHECK=1 — running uv run --no-sync just check" >&2
        uv run --no-sync just check 1>&2
    fi
}

if _run_fast_hooks "$@"; then
    first_rc=0
else
    first_rc=$?
fi

# Do not assume a zero hook status means the working tree was untouched.
# pre-commit detects tracked modifications, but a successful whole-tree tool can
# rewrite an untracked path without pre-commit converting that into a failure.
# Inspect the tree after every first pass so the wrapper can enforce its own
# safe-restaging boundary.
modified_paths=()
skipped_partial_paths=()
mapfile -d '' post_hook_modified_paths < <(git diff --name-only -z 2>/dev/null || true)
# Keep compatibility with constrained Git adapters that support per-path diff
# but not bulk NUL discovery; real Git normally populates the array above.
for path in "${staged_paths[@]}"; do
    [[ -n "$path" ]] || continue
    if ! git diff --quiet -- "$path" 2>/dev/null; then
        found=0
        for candidate in "${post_hook_modified_paths[@]}"; do
            [[ "$candidate" == "$path" ]] && found=1 && break
        done
        [[ "$found" == "1" ]] || post_hook_modified_paths+=("$path")
    fi
done
for path in "${post_hook_modified_paths[@]}"; do
    [[ -n "$path" ]] || continue
    if partial_index="$(_partial_path_index "$path")"; then
        # The file was already partially staged before hooks ran. Only call it
        # hook-modified if the unstaged diff changed; otherwise preserve the
        # original hook failure without a misleading auto-stage warning.
        if [[ "$(_partial_diff_hash "$path")" != "${partial_diff_hashes[$partial_index]}" ]]; then
            skipped_partial_paths+=("$path")
        fi
    elif dirty_index="$(_preexisting_unstaged_index "$path")"; then
        # Never stage pre-existing unstaged work. If Ruff changed it despite
        # pre-commit's stash boundary, fail explicitly rather than absorbing it.
        if [[ "$(_partial_diff_hash "$path")" != "${preexisting_unstaged_hashes[$dirty_index]}" ]]; then
            skipped_partial_paths+=("$path")
        fi
    elif _is_staged_path "$path"; then
        modified_paths+=("$path")
    else
        case "$path" in
          *.py|*.pyi) modified_paths+=("$path") ;;
        esac
    fi
done

# Ruff's whole-tree traversal can see untracked, non-ignored Python files. Never
# stage them; if a hook changed one, surface the path explicitly instead of
# returning an opaque formatter failure.
for index in "${!preexisting_untracked_paths[@]}"; do
    path="${preexisting_untracked_paths[$index]}"
    if [[ "$(_file_content_hash "$path")" != "${preexisting_untracked_hashes[$index]}" ]]; then
        skipped_partial_paths+=("$path")
    fi
done

# uv-lock is a whole-repo hook: changing pyproject.toml can update uv.lock even
# when uv.lock was not part of the initial staged path set. Auto-stage that lock
# refresh only when uv.lock was clean before hooks ran; otherwise avoid pulling
# unrelated pre-existing lockfile edits into the commit.
if [[ -f uv.lock ]] && ! _is_staged_path uv.lock && _is_staged_path pyproject.toml; then
    if ! git diff --quiet -- uv.lock 2>/dev/null; then
        if _partial_path_index pyproject.toml >/dev/null; then
            # uv-lock reads the working-tree pyproject.toml. If pyproject.toml
            # is partially staged, the generated uv.lock may reflect unstaged
            # dependency edits that are not part of the commit. Leave it to the
            # operator instead of auto-staging a mismatched lockfile.
            skipped_partial_paths+=("uv.lock")
        elif [[ "$uv_lock_dirty_before" == "0" ]]; then
            modified_paths+=("uv.lock")
        elif [[ "$(_partial_diff_hash uv.lock)" != "$uv_lock_diff_hash_before" ]]; then
            skipped_partial_paths+=("uv.lock")
        fi
    fi
fi

if [ ${#skipped_partial_paths[@]} -ne 0 ]; then
    echo "pre-commit: hooks modified pre-existing unstaged edits / partial staging / untracked files; refusing to auto-stage:" >&2
    printf '  %s
' "${skipped_partial_paths[@]}" >&2
    echo "pre-commit: stage or unstage those files explicitly, then commit again." >&2
    # A successful tool can still rewrite an untracked path without pre-commit
    # reporting failure. The safety refusal itself must remain commit-blocking.
    (( first_rc != 0 )) || first_rc=1
    exit "$first_rc"
fi

if [ ${#modified_paths[@]} -eq 0 ]; then
    if (( first_rc == 0 )); then
        _run_optional_full_check
    fi
    exit "$first_rc"
fi

echo "pre-commit: re-staging auto-fixed files and retrying:" >&2
printf '  %s
' "${modified_paths[@]}" >&2
git add -- "${modified_paths[@]}"

if _run_fast_hooks "$@"; then
    _run_optional_full_check
    exit 0
else
    retry_rc=$?
fi

exit "$retry_rc"
