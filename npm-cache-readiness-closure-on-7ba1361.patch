index c52292497a9c8786515d01ac6c2a4e56c264b216..33757469d7bee5adf4db202a9e74080a5671f354 100644
--- a/Dockerfile.fa
+++ b/Dockerfile.fa
@@ -122,6 +122,10 @@ RUN mkdir -p /repo /sessions \
 # Docker does not reliably derive HOME from /etc/passwd (it can default to "/");
 # the agent uses Path.home() for state (~/.fa/...), so pin it to the fa home.
