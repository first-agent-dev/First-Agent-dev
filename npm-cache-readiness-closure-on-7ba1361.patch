+# npm otherwise defaults to $HOME/.npm, but the runtime root filesystem —
+# including /home/fa itself — is intentionally read-only. Pre-commit's Node
+# environments need a cache/log root inside the writable HOME cache tmpfs.
+ENV NPM_CONFIG_CACHE=/home/fa/.cache/npm
 
 USER fa
 WORKDIR /workspace
