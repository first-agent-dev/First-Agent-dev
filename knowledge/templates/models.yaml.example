# First-Agent models.yaml — пример шаблона
#
# КАНОНИЧЕСКИЙ ПУТЬ В DEPLOY (AIO / Docker): /srv/first-agent/routing/models.yaml
#   Оператор редактирует ОДИН этот файл на хосте.
#   Он монтируется READ-ONLY в ОБА контейнера:
#   - агент: ~/.fa/models.yaml
#   - egress proxy: /etc/fa/models.yaml
#   После изменения пересоздайте стек, чтобы прокси перечитал маршруты, например:
#     scripts/fa-update.sh
#   (или: docker compose -f docker-compose.fa.yml up -d --force-recreate)
# ЛОКАЛЬНАЯ РАЗРАБОТКА (без Docker): ~/.fa/models.yaml
#
# ⚠️ Схема изменена (ADR-9 §Amendment 2026-07-23, hard cutover — жёсткая
# замена без обратной совместимости). Старые файлы со старыми именами полей
# (`model:` на уровне роли, `slug:` в chain entry, `extras:` на уровне роли)
# теперь ОТКЛОНЯЮТСЯ загрузчиком с явной подсказкой по миграции.
#
# ПРОВЕРКА СВОЕГО models.yaml перед деплоем (доли секунды, без Docker):
#   fa routing-check --config /srv/first-agent/routing/models.yaml
# Ловит: конфликт двух chain entry на один и тот же (provider, model) с
# разными api_key_env/base_url, и опечатки в base_url (например "v1" vs "vl").
#
# Этот файл описывает:
# - какую модель использовать (per-provider `model:` — РЕАЛЬНАЯ строка,
#   отправляемая в HTTP body как "model" именно этому провайдеру),
# - по какому URL ходить,
# - какое ИМЯ переменной с API-ключом ожидать,
# - опционально: sampling-параметры и provider-специфичные поля.
#
# Читаются следующие поля.
#
# На уровне роли:
#   name       (обязательно) — display-метка для логов/family-inference.
#              НИКОГДА не отправляется провайдеру (в отличие от chain-entry
#              `model:` ниже — не путайте эти два поля).
#   family     (обязательно) — используется ТОЛЬКО для ADR-2 eval-disjoint
#              проверки; в HTTP-запрос не попадает.
#   sampling   (опционально) — {temperature, max_tokens, top_p}, отправляется
#              ОДИНАКОВО во все chain entry этой роли.
#   chain      (обязательно) — упорядоченный список fallback-провайдеров.
#
# На уровне chain entry (внутри `chain:`):
#   provider          (обязательно) — выбирает адаптер (стиль авторизации +
#                     endpoint); в теле HTTP-запроса НЕ появляется.
#   model             (обязательно) — РЕАЛЬНАЯ строка модели ИМЕННО для этого
#                     провайдера — то, что физически уходит как "model" в
#                     JSON-теле запроса. У разных провайдеров для "одной и той
#                     же" модели эта строка может отличаться (см. пример
#                     fallback ниже) — указывайте то значение, которое
#                     ожидает конкретный провайдер, а не общее название.
#   base_url          (обязательно) — HTTPS URL провайдера.
#   api_key_env       (обязательно) — ИМЯ переменной окружения с ключом.
#   timeout_seconds   (опционально) — HTTP-таймаут одного запроса в секундах.
#   cooldown_seconds  (опционально) — локальная пауза после временного сбоя.
#   transport_retries (опционально) — дополнительные retry на транспорте.
#   extra_headers     (опционально) — доп. HTTP-заголовки для этого маршрута.
#   provider_params   (опционально) — provider-специфичные ПОЛЯ ТЕЛА запроса
#                     (например, у Mistral: reasoning_effort, safe_prompt,
#                     prompt_mode, parallel_tool_calls, prediction).
#                     Отправляются ТОЛЬКО этому entry — соседний fallback на
#                     другом провайдере их не получит.
#
# НИКОГДА не вставляйте сюда реальные API-ключи.
# api_key_env — это ИМЯ переменной, а реальное значение хранится ТОЛЬКО в:
#   /srv/first-agent/secrets/fa.env
# Например:
#   FIREWORKS_API_KEY=fw-...
#
# Поддерживаемые роли: planner, coder, debug, eval, chat.
# Конфиг с одной ролью тоже допустим.
#
# ⚠️ Правило eval-family (ADR-2 §Amendment 2026-05-20):
# если одновременно объявлены planner, coder и eval,
# то family у eval ОБЯЗАН отличаться и от planner, и от coder,
# иначе конфиг НЕ ЗАГРУЗИТСЯ (EvalFamilyConflictError).
# planner и coder могут делить одну family; только eval должен быть отдельным.

# ───────────────────────────────────────────────────────────────────────────
# Базовая конфигурация из трёх ролей (все через Fireworks; OpenAI-compatible adapter).
# planner = GLM 5.2, coder = MiniMax M3, eval = Nemotron 3 Ultra.
# family glm / minimax / nemotron все различны → правило ADR-2 соблюдено.
# ───────────────────────────────────────────────────────────────────────────

# Prompt caching is a per-provider capability, not universal. When I add a provider,
# I must decide whether it supports FA's cache params — from measured behavior, not assumptions."*
# The one knob lives in** `src/fa/providers/registry.py`, per-provider `MessageRules`.
# For new providers you ask one question:"Does it accept `prompt_cache_key` / `prompt_cache_retention`?"
# - YES / tested → default (`True`), keep cache benefit
# - NO / 400s → `supports_prompt_cache=False`
# - UNSURE → run `fa conformance --provider <name>` live — it now sends the **real** request shape
# and will surface a 400 if the provider rejects them.
# The rule is always **capability flag, never a provider-name** `if` (D2/CT6).
# ============================================================
# First-Agent models.yaml — S13 multi-provider config
#   planner: NVIDIA nemotron-3-ultra-550b (nemotron family)
#   coder:   NVIDIA deepseek-v4-flash     (deepseek family)
#   eval:    Mistral small-2603           (unchanged)
# Registry name: nvidia_build (OpenAI-compatible adapter).
# base_url https://integrate.api.nvidia.com/v1 -> /chat/completions
# ============================================================

planner:
  name: "anymodel planner"
  family: "qwen"
  sampling:
  chain:
    - provider: anymodel
      model: "qwen/qwen3.8-max"
      base_url: "https://anymodel.org/v1"
      api_key_env: ANYMODEL_API_KEY
      timeout_seconds: 600
      cooldown_seconds: 3
      transport_retries: 2
      provider_params:
        reasoning_effort: "xhigh"

    - provider: anymodel
      model: "am/kimi-k3"
      base_url: "https://anymodel.org/v1"
      api_key_env: ANYMODEL_API_KEY
      timeout_seconds: 600
      cooldown_seconds: 3
      transport_retries: 2
      provider_params:
        reasoning_effort: "max"

    - provider: anymodel
      model: "ag/gemini-3.7-flash-high"
      base_url: "https://anymodel.org/v1"
      api_key_env: ANYMODEL_API_KEY
      timeout_seconds: 600
      cooldown_seconds: 3
      transport_retries: 2
      provider_params:
        reasoning_effort: "high"

    - provider: anymodel
      model: "am/deepseek-v4-pro"
      base_url: "https://anymodel.org/v1"
      api_key_env: ANYMODEL_API_KEY
      timeout_seconds: 600
      cooldown_seconds: 3
      transport_retries: 2
      provider_params:
        reasoning_effort: "high"

coder:
  name: "anymodel coder"
  family: "anymodel"
  chain:
    - provider: anymodel
      model: "qwen/qwen3.8-max"
      base_url: "https://anymodel.org/v1"
      api_key_env: ANYMODEL_API_KEY
      timeout_seconds: 300
      cooldown_seconds: 3
      transport_retries: 2
  #    provider_params:
  #      reasoning_effort: "high"

    - provider: anymodel
      model: "am/kimi-k3"
      base_url: "https://anymodel.org/v1"
      api_key_env: ANYMODEL_API_KEY
      timeout_seconds: 300
      cooldown_seconds: 3
      transport_retries: 2
      provider_params:
        reasoning_effort: "high"

    - provider: anymodel
      model: "ag/gemini-3.7-flash-high"
      base_url: "https://anymodel.org/v1"
      api_key_env: ANYMODEL_API_KEY
      timeout_seconds: 600
      cooldown_seconds: 3
      transport_retries: 2
      provider_params:
        reasoning_effort: "high"

    - provider: anymodel
      model: "am/minimax-m3"
      base_url: "https://anymodel.org/v1"
      api_key_env: ANYMODEL_API_KEY
      timeout_seconds: 300
      cooldown_seconds: 3
      transport_retries: 2
   #   provider_params:
   #     reasoning_effort: "high"

    - provider: anymodel
      model: "am/deepseek-v4-pro"
      base_url: "https://anymodel.org/v1"
      api_key_env: ANYMODEL_API_KEY
      timeout_seconds: 300
      cooldown_seconds: 3
      transport_retries: 2
      provider_params:
        reasoning_effort: "high"



eval:
  name: "nemotron eval"
  family: "nemotron"
  chain:
    - provider: nvidia_build
      model: "nvidia/nemotron-3-ultra-550b-a55b"
      base_url: "https://integrate.api.nvidia.com/v1"
      api_key_env: NVIDIA_API_KEY
      timeout_seconds: 600
      cooldown_seconds: 3
      transport_retries: 2
      provider_params:
        # NVIDIA thinking mode (top-level body fields, same as the SDK's extra_body).
        chat_template_kwargs:
          enable_thinking: true
        reasoning_budget: 32000

    - provider: anymodel
      model: "am/minimax-m3"
      base_url: "https://anymodel.org/v1"
      api_key_env: ANYMODEL_API_KEY
      timeout_seconds: 300
      cooldown_seconds: 3
      transport_retries: 2
      provider_params:
        reasoning_effort: "high"

chat:
  name: "anymodel chat"
  family: "anymodel"
  chain:
    - provider: anymodel
      model: "am/kimi-k3"
      base_url: "https://anymodel.org/v1"
      api_key_env: ANYMODEL_API_KEY
      timeout_seconds: 300
      cooldown_seconds: 3
      transport_retries: 2
      provider_params:
        reasoning_effort: "high"

    - provider: anymodel
      model: "qwen/qwen3.8-max"
      base_url: "https://anymodel.org/v1"
      api_key_env: ANYMODEL_API_KEY
      timeout_seconds: 300
      cooldown_seconds: 3
      transport_retries: 2
      provider_params:
        reasoning_effort: "medium"

    - provider: anymodel
      model: "ag/gemini-3.7-flash-high"
      base_url: "https://anymodel.org/v1"
      api_key_env: ANYMODEL_API_KEY
      timeout_seconds: 600
      cooldown_seconds: 3
      transport_retries: 2
      provider_params:
        reasoning_effort: "high"

    - provider: anymodel
      model: "am/minimax-m3"
      base_url: "https://anymodel.org/v1"
      api_key_env: ANYMODEL_API_KEY
      timeout_seconds: 300
      cooldown_seconds: 3
      transport_retries: 2

        #    - provider: mistral
        #      model: "mistral-small-2603"
        #      base_url: "https://api.mistral.ai/v1"
        #      api_key_env: MISTRAL_API_KEY
        #      timeout_seconds: 240
        #      cooldown_seconds: 3
        #      transport_retries: 2
        #      provider_params:
        #        reasoning_effort: "high"

        # prediction:
        #   type: "content"
        #   content: "Previous expected output only"

        # response_format:
        #   type: "json_schema"
        #   json_schema:
        #     name: "evaluation"
        #     schema:
        #       type: "object"
        #       properties:
        #         verdict:
        #           type: "string"
        #       required:
        #         - verdict

        # parallel_tool_calls: true

        # prompt_cache_key: "eval-prefix-v1"

  # NOTE on coder's original 3-key rotation (MISTRAL_API_KEY / _1 / _2):
  # true multi-key rotation is NOT implemented in this codebase today
  # (tracked as BACKLOG I-32 — the egress-proxy route table and the
  # ProviderChain cooldown ledger both key on (provider, model) only, not
  # (provider, model, api_key_env), so 3 entries sharing the same model
  # string collide as one route in proxy mode and share one cooldown in
  # direct mode). Migrating the 3-entry shape as-is reproduces the exact
  # `route_conflict` failure the original deploy hit. Per your instruction,
  # coder is collapsed to its single confirmed-working key (MISTRAL_API_KEY)
  # below — this deploys cleanly today. If/when I-32 lands, the _1/_2 keys
  # can be reintroduced as genuine rotation entries.
  # Original entries preserved here for when I-32 lands:
  #
  #     - provider: mistral
  #       model: "mistral-small-2603"
  #       base_url: "https://api.mistral.ai/v1"
  #       api_key_env: MISTRAL_API_KEY_1
  #       timeout_seconds: 240
  #       cooldown_seconds: 3
  #       transport_retries: 1
  #       provider_params:
  #         reasoning_effort: "high"
  #     - provider: mistral
  #       model: "mistral-small-2603"
  #       base_url: "https://api.mistral.ai/v1"
  #       api_key_env: MISTRAL_API_KEY_2
  #       timeout_seconds: 240
  #       cooldown_seconds: 3
  #       transport_retries: 1
  #       provider_params:
  #         reasoning_effort: "high"


# S2/S10: chat — роль входа для complexity-aware execution. Скоуп-эстиматор
# стартует её в chat_direct; evidence-движок может эскалировать до
# workflow_linear через invoke_workflow. Маршрут (provider, model) разрешено
# разделять с другими ролями, если base_url и api_key_env совпадают
# (fa routing-check дедуплицирует идентичные маршруты); различаются только
# calibration-бакеты по recommended_mode, не модели.

# ───────────────────────────────────────────────────────────────────────────
# Примечания
# ───────────────────────────────────────────────────────────────────────────
# - Одна модель на ВСЕ роли (быстрый тест): объявляйте только те роли, которые
#   реально вызываете (например, только `coder`), либо не объявляйте `eval`.
#   Конфиг planner+coder+eval с ОДНОЙ И ТОЙ ЖЕ family будет отклонён правилом ADR-2.
# - В chain может быть несколько entry; агент пойдёт по ним сверху вниз при сбое.
#   ВАЖНО: у разных провайдеров модель может называться ПО-РАЗНОМУ даже когда
#   это "одна и та же" модель — указывайте то `model:`, которое ожидает
#   именно этот провайдер (пример ниже: minimax-m3 на Fireworks vs OpenRouter).
#   Пример fallback для одной роли:
#     chain:
#       - provider: fireworks
#         model: "accounts/fireworks/models/minimax-m3"
#         base_url: "https://api.fireworks.ai/inference/v1"
#         api_key_env: FIREWORKS_API_KEY
#       - provider: openrouter
#         model: "minimax/minimax-m3"
#         base_url: "https://openrouter.ai/api/v1"
#         api_key_env: OPENROUTER_API_KEY
#
# - `provider_params:` — provider-специфичные поля тела запроса, ТОЛЬКО для
#   данного entry (не путать с `extra_headers:` — это HTTP-заголовки).
#   Пример для Mistral-цепочки с fallback на не-Mistral провайдер:
#     chain:
#       - provider: mistral
#         model: "mistral-small-2603"
#         base_url: "https://api.mistral.ai/v1"
#         api_key_env: MISTRAL_API_KEY
#         provider_params:            # уходит ТОЛЬКО в mistral-запрос
#           reasoning_effort: "high"
#           safe_prompt: false
#       - provider: openrouter
#         model: "mistralai/mistral-small"
#         base_url: "https://openrouter.ai/api/v1"
#         api_key_env: OPENROUTER_API_KEY
#         # provider_params здесь не нужен — OpenRouter не понимает
#         # reasoning_effort/safe_prompt, и (после этой поправки ADR-9)
#         # действительно их не получит.
#
# ───────────────────────────────────────────────────────────────────────────
# Опциональная роль compactor (контекстная компакция — ADR-17).
# Когда объявлена и включён флаг context_compaction_enabled в config.yaml,
# fa run автоматически использует эту модель для сжатия контекста при
# достижении порога offload_threshold токенов. Семья compactor должна
# отличаться от coder/planner (правило ADR-2).
# ───────────────────────────────────────────────────────────────────────────
#
# compactor:
#   name: "phi-4-mini"
#   family: "phi"
#   chain:
#     - provider: fireworks
#       model: "accounts/fireworks/models/phi-4-mini"
#       base_url: "https://api.fireworks.ai/inference/v1"
#       api_key_env: FIREWORKS_API_KEY
#       timeout_seconds: 15
#
# ───────────────────────────────────────────────────────────────────────────
# Опциональная роль chat (общий разговорный режим — ADR-16 / P2-S2).
# Когда объявлена, `fa run --role chat` использует минимальный системный
# промпт и read-only набор инструментов (без write/edit/subagent).
# При необходимости может делегировать задачи в `fa workflow` через
# инструмент invoke_workflow (добавляется в S4).
# Семейство chat должно отличаться от planner/coder/eval (правило ADR-2).
# ───────────────────────────────────────────────────────────────────────────
#
# chat:
#   name: "glm-5p2"
#   family: "glm"
#   chain:
#     - provider: fireworks
#       model: "accounts/fireworks/models/glm-5p2"
#       base_url: "https://api.fireworks.ai/inference/v1"
#       api_key_env: FIREWORKS_API_KEY
#       timeout_seconds: 15
